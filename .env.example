# ═══════════════════════════════════════════════════
# SMS – Security Management System
# Umgebungsvariablen (.env.example)
# ═══════════════════════════════════════════════════
# Kopiere diese Datei als .env und passe die Werte an.

# ─── Allgemein ───
NODE_ENV=production
LOG_LEVEL=info

# ─── Ports ───
HTTP_PORT=80
HTTPS_PORT=443
API_URL=http://localhost:4000/api/v1
WS_URL=http://localhost:4000
CORS_ORIGIN=http://localhost

# ─── PostgreSQL ───
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=sms

# ─── JWT Authentifizierung ───
# Erzeuge sichere Zufallswerte:  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64

# ─── Backup ───
BACKUP_DIR=/var/backups/sms
BACKUP_RETENTION_DAYS=7

# ─── Upload-Limits ───
MAX_UPLOAD_SIZE_MB=10
