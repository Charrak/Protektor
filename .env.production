# ============================================
# SMS Production Environment
# ============================================
# WICHTIG: Alle Werte vor dem Deploy anpassen!
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DB_USER=sms_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_123!
DB_NAME=sms_db
DATABASE_URL=postgresql://sms_user:CHANGE_THIS_TO_A_STRONG_PASSWORD_123!@postgres:5432/sms_db

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_URL=redis://redis:6379

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# Generiere mit: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG!!!
JWT_EXPIRES_IN=7d

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=production
PORT=5000

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ORIGIN=https://sms-deinefirma.de

# --------------------------------------------
# API URL (für Frontend)
# --------------------------------------------
API_URL=https://api.sms-deinefirma.de

# --------------------------------------------
# Stripe Configuration (Production Keys!)
# --------------------------------------------
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# --------------------------------------------
# Email Configuration (SMTP)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --------------------------------------------
# Platform Admin (ERSTER ADMIN - PASSWORT ÄNDERN!)
# --------------------------------------------
PLATFORM_ADMIN_EMAIL=admin@sms-deinefirma.de
PLATFORM_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!

# --------------------------------------------
# Encryption Key (für sensible Daten)
# --------------------------------------------
# Generiere mit: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_ENCRYPTION_KEY_32_CHARS!

# --------------------------------------------
# License Configuration
# --------------------------------------------
OFFLINE_GRACE_MINUTES=1440
PAYMENT_GRACE_DAYS=7
DEFAULT_TRIAL_DAYS=30

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info
