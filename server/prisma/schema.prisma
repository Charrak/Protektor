// SMS – Security Management System
// Prisma Schema – Vollständige Datenbankdefinition

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════
// SAAS - MIETERTUM & ABONNEMENT
// ═══════════════════════════════════════════════════

model PlatformAdmin {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         PlatformSession[]
  notifications    PlatformNotification[]
  auditLogs        PlatformAuditLog[]
  createdTenants   Tenant[]            @relation("createdBy")
  modifiedTenants  Tenant[]            @relation("modifiedBy")

  @@map("platform_admins")
}

model PlatformSession {
  id             String   @id @default(uuid())
  adminId        String   @db.VarChar(36)
  token          String   @unique @db.VarChar(500)
  refreshToken   String   @unique @db.VarChar(500)
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.Text
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@map("platform_sessions")
}

model PlatformNotification {
  id        String   @id @default(uuid())
  adminId   String   @db.VarChar(36)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId, isRead])
  @@map("platform_notifications")
}

model PlatformAuditLog {
  id           String   @id @default(uuid())
  adminId      String?  @db.VarChar(36)
  adminName    String?  @db.VarChar(200)
  action       String   @db.VarChar(50)
  resourceType String   @db.VarChar(50)
  resourceId   String   @db.VarChar(36)
  oldValue     Json?
  newValue     Json?
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())

  admin PlatformAdmin? @relation(fields: [adminId], references: [id])

  @@index([resourceType, resourceId])
  @@map("platform_audit_logs")
}

model Tenant {
  id                  String      @id @default(uuid())
  tenantId            String      @unique @db.VarChar(36)
  licenseKey          String?     @unique @db.VarChar(100)
  companyName         String      @db.VarChar(200)
  contactEmail        String      @db.VarChar(255)
  contactPhone        String?     @db.VarChar(50)
  address             Json?
  taxNumber           String?     @db.VarChar(50)
  vatId               String?     @db.VarChar(50)
  stripeCustomerId    String?     @db.VarChar(255)
  licenseStatus       LicenseStatus @default(TEST)
  isActive            Boolean     @default(true)
  employeeLimit       Int?
  featureFlags        Json?
  
  // White-Label Branding
  logoUrl             String?     @db.VarChar(500)
  faviconUrl          String?     @db.VarChar(500)
  brandColor          String?     @db.VarChar(7)  // Hex color e.g. "#1e40af"
  loginMessage        String?     @db.VarChar(500)  // Custom welcome message
  
  // Password Setup Token (for initial tenant admin password setup)
  passwordResetToken      String?   @db.VarChar(255)
  passwordResetTokenExpiry DateTime?
  
  offlineGraceMinutes Int         @default(1440) // 24h default
  paymentGraceDays    Int         @default(7)
  lastLicenseCheck    DateTime?
  offlineSince        DateTime?
  notes               String?     @db.Text
  createdById         String      @db.VarChar(36)
  modifiedById        String?     @db.VarChar(36)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  createdBy        PlatformAdmin    @relation("createdBy", fields: [createdById], references: [id])
  modifiedBy       PlatformAdmin?   @relation("modifiedBy", fields: [modifiedById], references: [id])
  subscriptions    Subscription[]
  payments         Payment[]
  webhookEvents    WebhookEvent[]
  users            User[]
  employees        Employee[]
  customers        Customer[]
  objects          SMSObject[]
  deployments      Deployment[]
  timeRecords      TimeRecord[]
  invoices         CustomerInvoice[]
  addons           TenantAddon[]
  features         TenantFeature[]
  
  // Phase 2: Einsatzplanung & Compliance
  recurringAvailabilities RecurringAvailability[]
  employeeRestrictions    EmployeeRestriction[]
  employeeDocuments       EmployeeDocument[]
  timeCorrections         TimeCorrection[]
  availabilities          Availability[]
  breaks                  Break[]
  timePreferences         EmployeeTimePreference[]
  timeRequests            EmployeeTimeRequest[]
  
  // Phase 5: Kundenmanagement & Abrechnung
  customerDocuments       CustomerDocument[]
  shiftReports            ShiftReport[]
  reminders               Reminder[]
  customerAccessLogs      CustomerAccessLog[]
  customerUsers           CustomerUser[]
  contactPersons          ContactPerson[]
  tenantFieldConfigs      TenantFieldConfig[]
  
  // Security Features (Phase 36)
  roles              Role[]
  securityKeys       SecurityKey[]
  securityIncidents  SecurityIncident[]
  emergencyProtocols EmergencyProtocol[]
  accessPermissions  AccessPermission[]
  
  // Support & Feedback
  supportTickets     SupportTicket[]
  contactRequests    ContactRequest[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]

  // Planungsgruppen
  planningGroups     PlanningGroup[]

  @@map("tenants")
}

model Subscription {
  id                    String            @id @default(uuid())
  tenantId              String            @db.VarChar(36)
  stripeSubscriptionId  String?           @unique @db.VarChar(255)
  planId                String            @db.VarChar(36)
  status                SubscriptionStatus @default(ACTIVE)
  billingInterval       BillingInterval
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialStart            DateTime?
  trialEnd              DateTime?
  cancelAt              DateTime?
  canceledAt            DateTime?
  endedAt               DateTime?
  employeeCount         Int               @default(0)
  monthlyRevenue        Decimal           @db.Decimal(10, 2)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  plan         Plan     @relation(fields: [planId], references: [id])
  payments     Payment[]

  @@map("subscriptions")
}

model Plan {
  id              String          @id @default(uuid())
  name            String          @db.VarChar(100)
  slug            String          @unique @db.VarChar(50)
  description     String?         @db.Text
  monthlyPrice    Decimal         @db.Decimal(10, 2)
  yearlyPrice     Decimal         @db.Decimal(10, 2)
  employeeLimit   Int?
  stripeProductId String?         @db.VarChar(255)
  stripePriceIdMonthly String?    @db.VarChar(255)
  stripePriceIdYearly  String?    @db.VarChar(255)
  features        Json?
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Payment {
  id                    String          @id @default(uuid())
  tenantId              String          @db.VarChar(36)
  subscriptionId        String?         @db.VarChar(36)
  stripePaymentIntentId String?         @db.VarChar(255)
  stripeInvoiceId       String?         @db.VarChar(255)
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("EUR") @db.VarChar(3)
  status                PaymentStatus   @default(PENDING)
  paidAt                DateTime?
  failedAt              DateTime?
  failureReason         String?         @db.Text
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  tenantId     String?  @db.VarChar(36)
  stripeEventId String  @unique @db.VarChar(255)
  eventType    String   @db.VarChar(100)
  payload      Json
  processed    Boolean  @default(false)
  processedAt  DateTime?
  error        String?  @db.Text
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("webhook_events")
}

enum LicenseStatus {
  TEST
  ACTIVE
  PAYMENT_PENDING
  GRACE_PERIOD
  RESTRICTED
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  PAUSED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

// ═══════════════════════════════════════════════════
// BENUTZER & BERECHTIGUNGEN
// ═══════════════════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  tenantId     String   @db.VarChar(36)
  username     String   @db.VarChar(100)
  email        String   @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  roleId       String   @db.VarChar(36)
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  failedLogins Int      @default(0)
  lockedUntil  DateTime?
  passwordResetToken String? @db.VarChar(255)
  passwordResetTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  role              Role                @relation(fields: [roleId], references: [id])
  rolePermissions   RolePermission[]
  locks             Lock[]
  sessions          Session[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  createdDeployments Deployment[]     @relation("plannedBy")
  cancelledDeployments Deployment[]   @relation("cancelledBy")
  approvedTimeRecords TimeRecord[]    @relation("approvedBy")
  correctedTimeRecords TimeRecord[]   @relation("correctedBy")
  lockedTimeRecords  TimeRecord[]     @relation("lockedBy")
  uploadedDocuments EmployeeDocument[]
  verifiedDocuments  EmployeeDocument[] @relation("documentVerifier")
  verifiedQualifications EmployeeQualification[] @relation("verifiedBy")
  createdInvoices   CustomerInvoice[]
  requestedReplacements ReplacementRequest[] @relation("requestedBy")
  resolvedReplacements ReplacementRequest[] @relation("resolvedBy")
  approvedAvailabilities Availability[] @relation("approvedBy")
  approvedRecurringAvailabilities RecurringAvailability[] @relation("recurringApprovedBy")
  approvedTimeRequests EmployeeTimeRequest[] @relation("timeRequestApprovedBy")
  createdRestrictions EmployeeRestriction[] @relation("restrictionCreator")
  createdCorrections TimeCorrection[] @relation("correctionCreator")
  approvedCorrections TimeCorrection[] @relation("correctionApprover")
  changedTimeRecords TimeRecord[] @relation("timeChangedBy")
  approvedDeployments Deployment[] @relation("confirmedByEmployee")
  
  // Kunden-Dokumente & Mahnwesen
  uploadedCustomerDocuments  CustomerDocument[] @relation("customerDocUploadedBy")
  verifiedCustomerDocuments  CustomerDocument[] @relation("customerDocVerifiedBy")
  createdReminders           Reminder[]         @relation("reminderCreatedBy")
  
  // Planungsgruppen als Teamleiter
  leadPlanningGroups         PlanningGroup[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @db.VarChar(36)
  name        String   @db.VarChar(50)
  slug        String   @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @db.VarChar(36)
  permissionId String @db.VarChar(36)
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])
  users      User[]

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════
// MITARBEITER
// ═══════════════════════════════════════════════════

model Employee {
  id                String    @id @default(uuid())
  tenantId          String    @db.VarChar(36)
  personnelNumber   String    @db.VarChar(50)
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  dateOfBirth       DateTime? @db.Date
  birthPlace        String?   @db.VarChar(150)  // Geburtsort
  gender            Gender?
  nationality       String?   @db.VarChar(100)  // Staatsangehörigkeit
  maritalStatus     MaritalStatus?              // Familienstand
  street            String?   @db.VarChar(200)
  zipCode           String?   @db.VarChar(20)
  city              String?   @db.VarChar(100)
  country           String    @default("DE") @db.VarChar(100)
  phone             String?   @db.VarChar(50)
  mobile            String?   @db.VarChar(50)
  email             String?   @db.VarChar(255)
  
  // Notfallkontakt (Pflicht!)
  emergencyContactName  String? @db.VarChar(200)
  emergencyContactPhone String? @db.VarChar(50)
  emergencyContactRelation String? @db.VarChar(100)
  
  // Bankverbindung
  bankName          String?   @db.VarChar(100)
  iban              String?   @db.VarChar(34)
  bic               String?   @db.VarChar(11)
  
  // Steuern & Sozialversicherung
  taxId             String?   @db.VarChar(20)   // Steuer-ID
  taxClass          TaxClass?                   // Steuerklasse (1-6)
  religion          Religion?                   // Konfession (für Kirchensteuer)
  children          Int       @default(0)       // Kinderanzahl (für Steuerklasse)
  socialInsuranceId String?   @db.VarChar(30)   // Sozialversicherungsnummer
  pensionInsuranceId String?  @db.VarChar(30)   // Rentenversicherungsnummer
  healthInsurance   String?   @db.VarChar(100)  // Krankenkasse
  healthInsuranceId String?   @db.VarChar(30)   // Versichertennummer
  healthInsuranceType InsuranceType?            // Gesetzlich/Privat
  
  // Arbeitsvertrag
  employmentType    EmploymentType?
  contractType      ContractType?               // Unbefristet/Befristet
  weeklyHours       Decimal?  @db.Decimal(5, 2)
  contractStart     DateTime? @db.Date
  contractEnd       DateTime? @db.Date
  probationMonths   Int?                        // Probezeit in Monaten
  vacationDays      Int       @default(30)      // Urlaubstage
  department        String?   @db.VarChar(100)
  position          String?   @db.VarChar(100)
  costCenter        String?   @db.VarChar(50)
  
  // Vergütung
  hourlyRateBase    Decimal?  @db.Decimal(8, 2)
  monthlySalary     Decimal?  @db.Decimal(10, 2)  // Monatliches Festgehalt
  surchargeNight    Decimal?  @default(0) @db.Decimal(5, 2)
  surchargeSunday   Decimal?  @default(0) @db.Decimal(5, 2)
  surchargeHoliday  Decimal?  @default(0) @db.Decimal(5, 2)
  maxHoursPerDay    Decimal   @default(10.00) @db.Decimal(4, 2)
  maxHoursPerWeek   Decimal   @default(48.00) @db.Decimal(5, 2)
  preferredRegion   String?   @db.VarChar(100)
  
  // Zusatzinformationen
  driverLicense     String?   @db.VarChar(200)  // Führerschein-Klassen
  languages         String?   @db.VarChar(500)  // Sprachen
  uniformSize       String?   @db.VarChar(20)   // Uniformgröße
  shoeSize          Decimal?  @db.Decimal(3, 1) // Schuhgröße
  
  // ═══════════════════════════════════════════════════
  // SICHERHEITS-RELEVANTE FELDER (§34a GewO)
  // ═══════════════════════════════════════════════════
  bewachungserlaubnisNr    String? @db.VarChar(100)  // §34a GewO Lizenznummer
  bewachungserlaubnisExpiry DateTime? @db.Date        // Ablaufdatum Bewachungserlaubnis
  bewachungserlaubnisAuthority String? @db.VarChar(200) // Ausstellende Behörde
  
  // Unterrichtung nach §34a Abs. 1 Satz 4 GewO
  unterrichtungDatum    DateTime? @db.Date
  unterrichtungAuthority String? @db.VarChar(200)
  
  // Sachkundeprüfung §34a Abs. 1a GewO
  sachkundeDatum        DateTime? @db.Date
  sachkundeNr           String?   @db.VarChar(100)
  
  // Führungszeugnis (Pflicht!)
  fuehrungszeugnisDatum    DateTime? @db.Date
  fuehrungszeugnisArt      String?   @db.VarChar(100) // Privat/Gewerbe
  
  // Zuverlässigkeitsprüfung §7 GewO
  zuverlaessigkeetspruefung DateTime? @db.Date
  
  // Sicherheitsunterweisung
  unterweisungDatum        DateTime? @db.Date  // Letzte Sicherheitsunterweisung
  unterweisungNext         DateTime? @db.Date  // Nächste Unterweisung
  
  // Waffensachkunde (falls bewaffneter Dienst)
  waffensachkunde          Boolean @default(false)
  waffensachkundeExpiry    DateTime? @db.Date
  waffensachkundeNr        String?   @db.VarChar(100)
  
  // Erste Hilfe (alle 2 Jahre Auffrischung!)
  ersteHilfeCertified      Boolean @default(false)
  ersteHilfeExpiry         DateTime? @db.Date
  ersteHilfeHours          Int?                        // Anzahl Stunden
  
  // Zusatzqualifikationen
  sicherheitsstufe         Int @default(1)  // 1-5: Einfacher Dienst bis Führungsposition
  hundefuehrer             Boolean @default(false)
  hundefuehrerExpiry       DateTime? @db.Date
  brandschutzbeauftragter  Boolean @default(false)
  brandschutzExpiry        DateTime? @db.Date
  ersteHilfeTrainer        Boolean @default(false)
  
  // ═══════════════════════════════════════════════════
  // EINSATZRESTRIKTIONEN (ArbZG + Betriebliche Regeln)
  // ═══════════════════════════════════════════════════
  noNightShift             Boolean @default(false)  // Keine Nachtschicht (20-06 Uhr)
  noSundayShift            Boolean @default(false)  // Keine Sonntagsarbeit
  noHolidayShift           Boolean @default(false)  // Keine Feiertagsarbeit
  maxDailyHours            Decimal @default(10.00) @db.Decimal(4, 2)  // Max Stunden/Tag (ArbZG)
  maxWeeklyHours           Decimal @default(48.00) @db.Decimal(5, 2)  // Max Stunden/Woche
  minRestHours             Decimal @default(11.00) @db.Decimal(4, 2)  // Min Ruhezeit zw. Schichten (ArbZG: 11h)
  allowedRegions           Json?  // z.B. ["Berlin", "Brandenburg"] - Nur bestimmte Regionen
  allowedObjectIds         Json?  // Nur bestimmte Objekte (IDs)
  excludedObjectIds        Json?  // Explizit ausgeschlossene Objekte
  maxConsecutiveDays       Int @default(6)  // Max aufeinanderfolgende Arbeitstage
  nightShiftMinAge         Int?  // Mindestalter für Nachtschicht
  
  // Sonstiges
  notes             String?   @db.Text
  photoUrl          String?   @db.VarChar(500)
  status            EmployeeStatus @default(active)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant               Tenant  @relation(fields: [tenantId], references: [id])
  qualifications       EmployeeQualification[]
  documents            EmployeeDocument[]
  availabilities       Availability[]
  recurringAvailabilities RecurringAvailability[]
  restrictions         EmployeeRestriction[]
  deployments          Deployment[]
  timeRecords          TimeRecord[]
  rates                EmployeeRate[]
  originalReplacements ReplacementRequest[] @relation("originalEmployee")
  replacementEmployee  ReplacementRequest[] @relation("replacementEmployee")
  // Security Features (Phase 36)
  reportedIncidents    SecurityIncident[] @relation("incidentReporter")
  resolvedIncidents    SecurityIncident[] @relation("incidentResolver")
  accessPermissions    AccessPermission[]
  
  // Allowances (Zuschläge)
  allowances           Allowance[]

  // Planungsgruppen
  planningGroups       PlanningGroupEmployee[]

  // Zeitpräferenzen & Wünsche
  timePreferences      EmployeeTimePreference[]
  timeRequests         EmployeeTimeRequest[]

  @@unique([tenantId, personnelNumber])
  @@map("employees")
}

// ═══════════════════════════════════════════════════
// ZEITPRÄFERENZEN & WÜNSCHE
// ═══════════════════════════════════════════════════

model EmployeeTimePreference {
  id           String   @id @default(uuid())
  tenantId     String   @db.VarChar(36)
  employeeId   String   @db.VarChar(36)
  
  // Art der Präferenz
  type         TimePreferenceType  // preferred, restricted, requested
  
  // Wochentage (1=Mo, 7=So)
  weekdays     Int[]
  
  // Zeitfenster (optional, null = ganzer Tag)
  startTime    DateTime? @db.Time
  endTime      DateTime? @db.Time
  
  // Beschreibung/Grund
  reason       String?  @db.Text
  
  // Priorität (1=niedrig, 5=hoch)
  priority     Int      @default(3)
  
  // Status
  isActive     Boolean  @default(true)
  
  // Metadaten
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_time_preferences")
}

model EmployeeTimeRequest {
  id           String   @id @default(uuid())
  tenantId     String   @db.VarChar(36)
  employeeId   String   @db.VarChar(36)
  
  // Art der Anfrage
  type         TimeRequestType  // day_off, early_leave, late_start, extra_hours, swap
  
  // Datum oder Zeitraum
  date         DateTime @db.Date
  endDate      DateTime? @db.Date  // Für Zeiträume
  
  // Zeit (optional)
  startTime    DateTime? @db.Time
  endTime      DateTime? @db.Time
  
  // Grund
  reason       String   @db.Text
  
  // Genehmigungsworkflow
  status       ApprovalStatus @default(pending)
  approvedById String?  @db.VarChar(36)
  approvedAt   DateTime?
  rejectionReason String? @db.Text
  
  // Metadaten
  requestedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  employee     Employee @relation(fields: [employeeId], references: [id])
  approvedBy   User?    @relation("timeRequestApprovedBy", fields: [approvedById], references: [id])

  @@map("employee_time_requests")
}

enum TimePreferenceType {
  preferred     // Möchte zu diesen Zeiten arbeiten
  restricted    // Kann zu diesen Zeiten NICHT arbeiten
  requested     // Wunsch für bestimmte Zeiten
}

enum TimeRequestType {
  day_off       // Ganzer Tag frei
  early_leave   // Früher Schluss
  late_start    // Später anfangen
  extra_hours   // Mehr Stunden
  swap          // Schicht tauschen
}

enum Gender {
  male
  female
  diverse
}

enum EmploymentType {
  full_time
  part_time
  mini_job
  freelance
}

enum EmployeeStatus {
  active
  inactive
  on_leave
  terminated
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  civil_partnership
}

enum TaxClass {
  I
  II
  III
  IV
  V
  VI
}

enum Religion {
  none
  catholic
  protestant
  other
}

enum InsuranceType {
  statutory   // Gesetzlich
  private     // Privat
  family      // Familienversicherung
}

enum ContractType {
  permanent      // Unbefristet
  fixed_term     // Befristet
  temp           // Leiharbeit
  working_student // Werkstudent
}

// ═══════════════════════════════════════════════════
// QUALIFIKATIONEN
// ═══════════════════════════════════════════════════

model Qualification {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  category        String?  @db.VarChar(50)
  validityDays    Int?
  requiresRenewal Boolean  @default(true)
  color           String?  @db.VarChar(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employeeQualifications EmployeeQualification[]
  objectRequirements     ObjectRequirement[]

  @@map("qualifications")
}

model EmployeeQualification {
  id                String    @id @default(uuid())
  employeeId        String    @db.VarChar(36)
  qualificationId   String    @db.VarChar(36)
  obtainedDate      DateTime  @db.Date
  expiryDate        DateTime? @db.Date
  certificateNumber String?   @db.VarChar(100)
  documentUrl       String?   @db.VarChar(500)
  isVerified        Boolean   @default(false)
  verifiedById      String?   @db.VarChar(36)
  verifiedAt        DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee      Employee      @relation(fields: [employeeId], references: [id])
  qualification Qualification @relation(fields: [qualificationId], references: [id])
  verifiedBy    User?         @relation("verifiedBy", fields: [verifiedById], references: [id])

  @@unique([employeeId, qualificationId])
  @@map("employee_qualifications")
}

model EmployeeDocument {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  employeeId      String   @db.VarChar(36)
  fileName        String   @db.VarChar(255)
  fileUrl         String   @db.VarChar(500)
  fileSize        Int?
  mimeType        String?  @db.VarChar(100)
  category        DocumentCategory @default(other)
  subCategory     String?  @db.VarChar(100)  // z.B. "Bewachungserlaubnis", "Führungszeugnis"
  
  // Versionierung
  version         Int      @default(1)
  previousVersionId String? @db.VarChar(36)  // Vorgänger-Dokument
  isLatestVersion Boolean  @default(true)
  
  // Ablauf-Tracking
  expiryDate      DateTime? @db.Date  // Ablaufdatum des Dokuments
  reminderDays    Int      @default(90) // Erinnerung X Tage vor Ablauf
  lastRemindedAt  DateTime?
  
  // Metadaten
  description     String?  @db.Text
  tags            Json?    // z.B. ["§34a", "Pflicht"]
  uploadedById    String?  @db.VarChar(36)
  verifiedById    String?  @db.VarChar(36)
  verifiedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?  // Soft-Delete für Versionshistorie

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  employee        Employee @relation(fields: [employeeId], references: [id])
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id])
  verifiedBy      User?    @relation("documentVerifier", fields: [verifiedById], references: [id])
  previousVersion EmployeeDocument? @relation("documentVersions", fields: [previousVersionId], references: [id])
  versions        EmployeeDocument[] @relation("documentVersions")

  @@map("employee_documents")
}

enum DocumentCategory {
  contract          // Arbeitsvertrag
  amendment         // Vertragsänderung
  qualification     // Nachweise/Zertifikate
  license           // Bewachungserlaubnis, Waffenschein etc.
  health            // Gesundheitszeugnisse, Erste Hilfe
  identification    // Ausweis, Pass, Geburtsurkunde
  tax               // Steuerunterlagen
  insurance         // Versicherungsunterlagen
  training          // Unterweisungen, Schulungen
  termination       // Kündigung, Austritt
  other             // Sonstiges
}

// ═══════════════════════════════════════════════════
// VERFÜGBARKEITEN
// ═══════════════════════════════════════════════════

model Availability {
  id           String    @id @default(uuid())
  tenantId     String    @db.VarChar(36)
  employeeId   String    @db.VarChar(36)
  type         AvailabilityType
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  allDay       Boolean   @default(true)
  startTime    DateTime? @db.Time
  endTime      DateTime? @db.Time
  reason       String?   @db.Text
  approvedById String?   @db.VarChar(36)
  approvedAt   DateTime?
  status       ApprovalStatus @default(pending)
  requestedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])
  approvedBy User?      @relation("approvedBy", fields: [approvedById], references: [id])

  @@map("availabilities")
}

// ═══════════════════════════════════════════════════
// WIEDERKEHRENDE VERFÜGBARKEITEN (Wöchentliche Muster)
// ═══════════════════════════════════════════════════

model RecurringAvailability {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  employeeId      String   @db.VarChar(36)
  dayOfWeek       Int      // 1=Montag ... 7=Sonntag
  startTime       DateTime @db.Time
  endTime         DateTime @db.Time
  validFrom       DateTime @db.Date   // Ab wann gilt dieses Muster
  validUntil      DateTime? @db.Date  // Bis wann (null = unbegrenzt)
  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  approvedById    String?  @db.VarChar(36)
  approvedAt      DateTime?
  status          ApprovalStatus @default(pending)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
  approvedBy      User?     @relation("recurringApprovedBy", fields: [approvedById], references: [id])

  @@unique([tenantId, employeeId, dayOfWeek, startTime, endTime])
  @@map("recurring_availabilities")
}

// ═══════════════════════════════════════════════════
// EINSATZRESTRIKTIONEN (Explizite Regeln)
// ═══════════════════════════════════════════════════

model EmployeeRestriction {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  employeeId      String   @db.VarChar(36)
  type            RestrictionType
  description     String?  @db.Text
  value           String?  @db.VarChar(255)  // JSON oder einfacher Wert
  objectId        String?  @db.VarChar(36)   // Falls Objekt-spezifisch
  validFrom       DateTime? @db.Date
  validUntil      DateTime? @db.Date
  isActive        Boolean  @default(true)
  createdBy       String?  @db.VarChar(36)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  employee        Employee @relation(fields: [employeeId], references: [id])
  object          SMSObject? @relation(fields: [objectId], references: [id])
  creator         User?    @relation("restrictionCreator", fields: [createdBy], references: [id])

  @@map("employee_restrictions")
}

enum RestrictionType {
  no_night_shift       // Keine Nachtschicht
  no_sunday            // Keine Sonntagsarbeit
  no_holiday           // Keine Feiertagsarbeit
  max_daily_hours      // Max Stunden pro Tag
  max_weekly_hours     // Max Stunden pro Woche
  min_rest_hours       // Min Ruhezeit zwischen Schichten
  allowed_region       // Nur bestimmte Region
  excluded_object      // Bestimmtes Objekt ausgeschlossen
  allowed_object       // Nur bestimmtes Objekt erlaubt
  max_consecutive_days // Max aufeinanderfolgende Tage
  night_min_age        // Mindestalter Nachtschicht
  custom               // Benutzerdefiniert
}

enum AvailabilityType {
  available
  vacation
  sick
  personal
  training
  other
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// ═══════════════════════════════════════════════════
// KUNDEN & OBJEKTE
// ═══════════════════════════════════════════════════

model Customer {
  id             String          @id @default(uuid())
  tenantId       String          @db.VarChar(36)
  customerNumber String          @db.VarChar(50)  // Auto: KD-2026-0001
  
  // Firmeninformationen
  companyName    String          @db.VarChar(200)
  legalForm      String?         @db.VarChar(50)   // GmbH, AG, etc.
  department     String?         @db.VarChar(100)
  
  // Firmenadresse
  street         String          @db.VarChar(200)
  zipCode        String          @db.VarChar(20)
  city           String          @db.VarChar(100)
  country        String          @default("DE") @db.VarChar(100)
  
  // Kontakt
  phone          String?         @db.VarChar(50)
  fax            String?         @db.VarChar(50)
  email          String?         @db.VarChar(255)
  website        String?         @db.VarChar(255)
  
  // Steuerdaten
  taxNumber      String?         @db.VarChar(50)
  vatId          String?         @db.VarChar(50)   // USt-IdNr.
  
  // RECHNUNGSDATEN (Pflicht für Rechnungsstellung)
  invoiceStreet         String?  @db.VarChar(200)   // Abweichende Rechnungsanschrift
  invoiceZipCode        String?  @db.VarChar(20)
  invoiceCity           String?  @db.VarChar(100)
  invoiceCountry        String   @default("DE") @db.VarChar(100)
  invoiceRecipientName  String?  @db.VarChar(200)   // Abweichender Rechnungsempfänger
  invoiceEmail          String?  @db.VarChar(255)   // Rechnungs-E-Mail (Pflicht!)
  invoicePhone          String?  @db.VarChar(50)
  invoiceDeliveryMethod InvoiceDeliveryMethod @default(email)
  
  // VERTRAGSDATEN
  contractNumber        String?  @db.VarChar(100)
  contractStartDate     DateTime? @db.Date
  contractEndDate       DateTime? @db.Date
  terminationNoticePeriod Int    @default(90)        // Tage vor Vertragsende
  billingType           BillingType @default(hourly)
  billingInterval       CustomerBillingInterval @default(monthly)
  
  // ZAHLUNGSBEDINGUNGEN
  paymentTerms          Int      @default(14)        // Tage
  reminderStatus        ReminderStatus @default(none)
  
  // SONSTIGES
  purchaseOrderNumber   String?  @db.VarChar(100)    // Bestellnummer/Kostenstelle
  notes                 String?  @db.Text
  status                CustomerStatus @default(active)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  contactPersons        ContactPerson[]
  objects               SMSObject[]
  rates                 CustomerRate[]
  invoices              CustomerInvoice[]
  documents             CustomerDocument[]
  shiftReports          ShiftReport[]
  accessLogs            CustomerAccessLog[]
  reminders             Reminder[]
  portalUsers           CustomerUser[]

  @@unique([tenantId, customerNumber])
  @@map("customers")
}

enum CustomerStatus {
  active
  inactive
  prospect
}

enum InvoiceDeliveryMethod {
  email
  portal
  post
}

enum BillingType {
  hourly        // Stundenbasiert
  perPost       // Pro Posten
  lumpSum       // Pauschale
  mixed         // Mischform
}

enum CustomerBillingInterval {
  monthly
  quarterly
  yearly
}

enum ReminderStatus {
  none
  reminder1     // Zahlungserinnerung
  reminder2     // 1. Mahnung
  reminder3     // 2. Mahnung
}

model ContactPerson {
  id                String   @id @default(uuid())
  tenantId          String   @db.VarChar(36)
  customerId        String   @db.VarChar(36)
  firstName         String   @db.VarChar(100)
  lastName          String   @db.VarChar(100)
  role              String?  @db.VarChar(100)
  phone             String?  @db.VarChar(50)
  mobile            String?  @db.VarChar(50)
  email             String?  @db.VarChar(255)
  isPrimary         Boolean  @default(false)
  isInvoiceContact  Boolean  @default(false)   // Ansprechpartner Rechnung
  isEmergencyContact Boolean @default(false)   // Notfallkontakt
  availability      String?  @db.VarChar(200)   // Erreichbarkeitszeiten
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  objects  SMSObject[]
  portalUsers CustomerUser[]
  invoices CustomerInvoice[] @relation("invoiceBillingContact")

  @@map("contact_persons")
}

model SMSObject {
  id                  String   @id @default(uuid())
  tenantId            String   @db.VarChar(36)
  objectNumber        String   @db.VarChar(50)
  customerId          String   @db.VarChar(36)
  name                String   @db.VarChar(200)
  street              String?  @db.VarChar(200)
  zipCode             String?  @db.VarChar(20)
  city                String?  @db.VarChar(100)
  description         String?  @db.Text
  objectType          String?  @db.VarChar(50)
  contactPersonId     String?  @db.VarChar(36)
  
  // Sicherheit & Zugang
  alarmNumber         String?  @db.VarChar(50)
  keyDepot            String?  @db.Text
  accessCode          String?  @db.VarChar(100)
  accessRegulations   String?  @db.Text        // Zutrittsregelungen
  specialInstructions String?  @db.Text
  
  // PERSONAL & AUSRÜSTUNG
  requiredPersonnel   Int      @default(1)     // Postenanzahl
  equipmentRequirements String? @db.Text       // Ausrüstung/Kleidung
  
  // NOTFALL & ALARM
  alarmPlan           String?  @db.Text        // Alarmplan
  emergencyContacts   Json?                    // Array: [{name, phone, role, availability}]
  
  // LEISTUNG
  serviceType         ServiceType @default(objectProtection)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  contactPerson   ContactPerson?    @relation(fields: [contactPersonId], references: [id])
  requirements    ObjectRequirement[]
  shiftPatterns   ObjectShiftPattern[]
  deployments     Deployment[]
  rates           CustomerRate[]
  restrictions    EmployeeRestriction[]
  timeRecords     TimeRecord[]
  shiftReports    ShiftReport[]
  
  // Security Features (Phase 36)
  securityKeys       SecurityKey[]
  securityIncidents  SecurityIncident[]
  emergencyProtocols EmergencyProtocol[]
  accessPermissions  AccessPermission[]

  // Planungsgruppen
  planningGroups     PlanningGroupObject[]

  @@unique([tenantId, objectNumber])
  @@map("objects")
}

enum ServiceType {
  objectProtection   // Objektschutz
  guardService       // Wachdienst
  entryControl       // Einlasskontrolle
  patrolService      // Streifendienst
  eventSecurity      // Veranstaltungsschutz
}

model ObjectRequirement {
  id              String  @id @default(uuid())
  objectId        String  @db.VarChar(36)
  qualificationId String  @db.VarChar(36)
  isMandatory     Boolean @default(true)
  notes           String? @db.Text
  createdAt       DateTime @default(now())

  object        SMSObject     @relation(fields: [objectId], references: [id])
  qualification Qualification @relation(fields: [qualificationId], references: [id])

  @@unique([objectId, qualificationId])
  @@map("object_requirements")
}

model ObjectShiftPattern {
  id                  String   @id @default(uuid())
  objectId            String   @db.VarChar(36)
  name                String   @db.VarChar(100)  // z.B. "Tagschicht", "Nachtschicht", "Wochenende"
  
  // Wochentage als Array (1=Mo, 7=So) - welche Tage dieses Muster gilt
  weekdays            Int[]                      // z.B. [1,2,3,4,5] für Mo-Fr
  
  // Arbeitszeiten
  startTime           DateTime @db.Time
  endTime             DateTime @db.Time
  breakMinutes        Int      @default(0)
  
  // Personalanforderung
  requiredPersonnel   Int      @default(1)       // MA-Anzahl pro Schicht
  
  // Optional: Spezifische Qualifikationen für diese Schicht
  notes               String?  @db.Text
  
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  object              SMSObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@map("object_shift_patterns")
}

model CustomerRate {
  id          String    @id @default(uuid())
  customerId  String    @db.VarChar(36)
  objectId    String?   @db.VarChar(36)
  serviceType String    @db.VarChar(50)
  rateNormal  Decimal   @db.Decimal(8, 2)
  rateNight   Decimal?  @db.Decimal(8, 2)
  rateSunday  Decimal?  @db.Decimal(8, 2)
  rateHoliday Decimal?  @db.Decimal(8, 2)
  validFrom   DateTime  @db.Date
  validUntil  DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  object   SMSObject? @relation(fields: [objectId], references: [id])

  @@map("customer_rates")
}

// ═══════════════════════════════════════════════════
// PLANUNGSGRUPPEN (Flexible Objekt-/Mitarbeiter-Zuordnung)
// ═══════════════════════════════════════════════════

model PlanningGroup {
  id          String   @id @default(uuid())
  tenantId    String   @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  color       String?  @db.VarChar(7)         // Farbe für UI-Darstellung
  
  // Teamleiter und Vertreter
  leadUserId  String?  @db.VarChar(36)        // Verantwortlicher Teamleiter
  leadDeputies String[] @default([])          // Vertreter des Teamleiters
  
  isActive    Boolean  @default(true)
  createdBy   String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  leadUser    User?               @relation(fields: [leadUserId], references: [id])
  objects     PlanningGroupObject[]
  employees   PlanningGroupEmployee[]

  @@unique([tenantId, name])
  @@map("planning_groups")
}

model PlanningGroupObject {
  id              String   @id @default(uuid())
  planningGroupId String   @db.VarChar(36)
  objectId        String   @db.VarChar(36)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  planningGroup   PlanningGroup @relation(fields: [planningGroupId], references: [id], onDelete: Cascade)
  object          SMSObject     @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([planningGroupId, objectId])
  @@map("planning_group_objects")
}

model PlanningGroupEmployee {
  id              String   @id @default(uuid())
  planningGroupId String   @db.VarChar(36)
  employeeId      String   @db.VarChar(36)
  isPrimary       Boolean  @default(false)    // Hauptzuordnung (für Standard-Planung)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  planningGroup   PlanningGroup @relation(fields: [planningGroupId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([planningGroupId, employeeId])
  @@map("planning_group_employees")
}

// ═══════════════════════════════════════════════════
// DIENSTPLANUNG & EINSÄTZE
// ═══════════════════════════════════════════════════

model Shift {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  startTime    DateTime @db.Time
  endTime      DateTime @db.Time
  breakMinutes Int      @default(0)
  isNightShift Boolean  @default(false)
  color        String?  @db.VarChar(7)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deployments Deployment[]

  @@map("shifts")
}

model Deployment {
  id                 String    @id @default(uuid())
  tenantId           String    @db.VarChar(36)
  objectId           String    @db.VarChar(36)
  employeeId         String    @db.VarChar(36)
  date               DateTime  @db.Date
  shiftId            String?   @db.VarChar(36)
  startTime          DateTime  @db.Time
  endTime            DateTime  @db.Time
  breakMinutes       Int       @default(0)
  isNightShift       Boolean   @default(false)
  isSunday           Boolean   @default(false)
  isHoliday          Boolean   @default(false)
  status             DeploymentStatus @default(planned)
  confirmedById      String?   @db.VarChar(36)
  confirmedAt        DateTime?
  cancelledById      String?   @db.VarChar(36)
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  replacementId      String?   @db.VarChar(36)
  plannedById        String    @db.VarChar(36)
  notes              String?   @db.Text
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  object              SMSObject    @relation(fields: [objectId], references: [id])
  employee            Employee     @relation(fields: [employeeId], references: [id])
  shift               Shift?       @relation(fields: [shiftId], references: [id])
  plannedBy           User         @relation("plannedBy", fields: [plannedById], references: [id])
  cancelledBy         User?        @relation("cancelledBy", fields: [cancelledById], references: [id])
  confirmedByEmployee User?        @relation("confirmedByEmployee", fields: [confirmedById], references: [id])
  timeRecords         TimeRecord[]
  replacementRequests ReplacementRequest[]
  
  // Security Features (Phase 36)
  securityIncidents   SecurityIncident[]

  @@map("deployments")
}

enum DeploymentStatus {
  planned
  released
  confirmed
  declined
  cancelled
  completed
  no_show
}

// ═══════════════════════════════════════════════════
// ZEITERFASSUNG
// ═══════════════════════════════════════════════════

model TimeRecord {
  id               String    @id @default(uuid())
  tenantId         String    @db.VarChar(36)
  employeeId       String    @db.VarChar(36)
  deploymentId     String?   @db.VarChar(36)
  date             DateTime  @db.Date
  
  // Einsatzort & Tätigkeit
  objectId         String?   @db.VarChar(36)
  postNumber       String?   @db.VarChar(50)  // Postennummer
  activityType     String?   @db.VarChar(100) // Tätigkeit
  
  // Stempelzeiten
  clockIn          DateTime
  clockOut         DateTime?
  
  // Pausen (können mehrere sein)
  breakDuration    Int       @default(0)  // In Minuten
  
  // Arbeitszeiten nach Art
  regularHours     Decimal?  @db.Decimal(5, 2)  // Normale Stunden
  nightHours       Decimal?  @db.Decimal(5, 2)  // Nacht (20-06 Uhr)
  sundayHours      Decimal?  @db.Decimal(5, 2)  // Sonntagsarbeit
  holidayHours     Decimal?  @db.Decimal(5, 2)  // Feiertagsarbeit
  overtimeHours    Decimal?  @db.Decimal(5, 2)  // Überstunden
  totalHours       Decimal?  @db.Decimal(5, 2)  // Gesamt
  
  // Status & Genehmigung
  status           TimeRecordStatus @default(open)
  approvedById     String?   @db.VarChar(36)
  approvedAt       DateTime?
  
  // Korrektur & Historie
  correctionReason String?   @db.Text
  correctedById    String?   @db.VarChar(36)
  isLocked         Boolean   @default(false)  // Nach Genehmigung gesperrt
  lockedById       String?   @db.VarChar(36)
  lockedAt         DateTime?
  lockReason       String?   @db.Text
  
  // Zuschlagssätze (für Abrechnung)
  nightSurchargePct Decimal? @db.Decimal(5, 2)  // z.B. 25%
  sundaySurchargePct Decimal? @db.Decimal(5, 2) // z.B. 50%
  holidaySurchargePct Decimal? @db.Decimal(5, 2) // z.B. 100%
  
  // Zuschläge in € (berechnet)
  nightSurcharge   Decimal? @db.Decimal(8, 2)
  sundaySurcharge  Decimal? @db.Decimal(8, 2)
  holidaySurcharge Decimal? @db.Decimal(8, 2)
  totalSurcharge   Decimal? @db.Decimal(8, 2)
  
  // Notizen & Quelle
  notes            String?   @db.Text
  sourceType       TimeRecordSource @default(manual)  // manuell, stempel, app
  sourceDevice     String?   @db.VarChar(100)  // z.B. "Mobile App", "Terminal"
  
  // Export
  exportedForPayroll Boolean @default(false)
  exportedForCustomer Boolean @default(false)
  exportDate       DateTime?
  
  // Audit-Trail
  changedById      String?   @db.VarChar(36)
  changedAt        DateTime?
  changeReason     String?   @db.Text
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  deployment  Deployment?  @relation(fields: [deploymentId], references: [id])
  object      SMSObject?   @relation(fields: [objectId], references: [id])
  approvedBy  User?        @relation("approvedBy", fields: [approvedById], references: [id])
  correctedBy User?        @relation("correctedBy", fields: [correctedById], references: [id])
  lockedBy    User?        @relation("lockedBy", fields: [lockedById], references: [id])
  changedBy   User?        @relation("timeChangedBy", fields: [changedById], references: [id])
  breaks      Break[]
  corrections TimeCorrection[]

  @@map("time_records")
}

enum TimeRecordStatus {
  open       // Noch nicht beendet
  completed  // Beendet, wartet auf Genehmigung
  approved   // Genehmigt
  rejected   // Abgelehnt, muss korrigiert werden
  locked     // Endgültig gesperrt (für Abrechnung)
}

enum TimeRecordSource {
  manual     // Manuell eingetragen
  stamp      // Terminal-Stempel
  app        // Mobile App
  import     // Import aus externem System
}

// Korrektur-Historie für Zeitnachweise
model TimeCorrection {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  timeRecordId    String   @db.VarChar(36)
  correctedById   String   @db.VarChar(36)
  fieldChanged    String   @db.VarChar(50)  // z.B. "clockOut", "breakDuration"
  oldValue        String?  @db.VarChar(255)
  newValue        String?  @db.VarChar(255)
  reason          String   @db.Text
  approvedById    String?  @db.VarChar(36)
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  timeRecord      TimeRecord   @relation(fields: [timeRecordId], references: [id])
  correctedBy     User         @relation("correctionCreator", fields: [correctedById], references: [id])
  approvedBy      User?        @relation("correctionApprover", fields: [approvedById], references: [id])

  @@map("time_corrections")
}

model Break {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  timeRecordId    String    @db.VarChar(36)
  breakStart      DateTime
  breakEnd        DateTime?
  durationMinutes Int?
  breakType       String?   @db.VarChar(50)  // "paid", "unpaid", "meal"
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  timeRecord TimeRecord @relation(fields: [timeRecordId], references: [id])

  @@map("breaks")
}

// ═══════════════════════════════════════════════════
// VERGÜTUNG & ABRECHNUNG
// ═══════════════════════════════════════════════════

model EmployeeRate {
  id            String    @id @default(uuid())
  employeeId    String    @db.VarChar(36)
  rateBase      Decimal   @db.Decimal(8, 2)
  rateNight     Decimal?  @db.Decimal(8, 2)
  rateSunday    Decimal?  @db.Decimal(8, 2)
  rateHoliday   Decimal?  @db.Decimal(8, 2)
  surchargeType SurchargeType @default(percentage)
  validFrom     DateTime  @db.Date
  validUntil    DateTime? @db.Date
  approvedById  String?   @db.VarChar(36)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_rates")
}

enum SurchargeType {
  absolute
  percentage
}

model CustomerInvoice {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  invoiceNumber   String    @db.VarChar(50)
  customerId      String    @db.VarChar(36)
  
  // Rechnungsdaten
  invoiceDate     DateTime  @db.Date
  dueDate         DateTime  @db.Date
  periodStart     DateTime  @db.Date
  periodEnd       DateTime  @db.Date
  
  // Kundenreferenz
  purchaseOrderNumber String? @db.VarChar(100)  // Bestellnummer/Kostenstelle
  billingContactId    String? @db.VarChar(36)   // Ansprechpartner Rechnung
  
  // Beträge
  subtotal        Decimal   @db.Decimal(10, 2)
  taxRate         Decimal   @default(19.00) @db.Decimal(5, 2)
  taxAmount       Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  
  // Status & Versand
  status          InvoiceStatus @default(draft)
  reminderStatus  ReminderStatus @default(none)
  sentAt          DateTime?
  paidAt          DateTime?
  pdfUrl          String?   @db.VarChar(500)
  deliveryMethod  InvoiceDeliveryMethod @default(email)
  
  // Metadaten
  notes           String?   @db.Text
  createdById     String    @db.VarChar(36)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  billingContact  ContactPerson?    @relation("invoiceBillingContact", fields: [billingContactId], references: [id])
  positions       InvoicePosition[]
  createdBy       User              @relation(fields: [createdById], references: [id])
  reminders       Reminder[]

  @@unique([tenantId, invoiceNumber])
  @@map("customer_invoices")
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

model InvoicePosition {
  id           String   @id @default(uuid())
  invoiceId    String   @db.VarChar(36)
  objectId     String?  @db.VarChar(36)
  employeeId   String?  @db.VarChar(36)
  description  String   @db.Text
  quantity     Decimal  @db.Decimal(8, 2)
  unit         String   @default("Stunden") @db.VarChar(20)
  ratePerUnit  Decimal  @db.Decimal(8, 2)
  totalAmount  Decimal  @db.Decimal(10, 2)
  serviceType  String?  @db.VarChar(50)
  serviceDate  DateTime? @db.Date
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_positions")
}

// ═══════════════════════════════════════════════════
// KUNDEN-DOKUMENTE (Verträge, AVV, Nachweise)
// ═══════════════════════════════════════════════════

model CustomerDocument {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  customerId      String   @db.VarChar(36)
  fileName        String   @db.VarChar(255)
  fileUrl         String   @db.VarChar(500)
  fileSize        Int?
  mimeType        String?  @db.VarChar(100)
  category        CustomerDocumentCategory @default(other)
  description     String?  @db.Text
  
  // Versionierung
  version         Int      @default(1)
  previousVersionId String? @db.VarChar(36)
  isLatestVersion Boolean  @default(true)
  
  // Ablauf-Tracking
  expiryDate      DateTime? @db.Date
  reminderDays    Int      @default(90)
  
  // DSGVO
  purpose         DataPurpose @default(contractFulfillment)
  retentionPeriodMonths Int?  // Aufbewahrungsfrist in Monaten
  deleteAt        DateTime?   // Automatisches Löschdatum
  
  // Metadaten
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  uploadedById    String?  @db.VarChar(36)
  verifiedById    String?  @db.VarChar(36)
  uploadedBy      User?    @relation("customerDocUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy      User?    @relation("customerDocVerifiedBy", fields: [verifiedById], references: [id])

  @@map("customer_documents")
}

enum CustomerDocumentCategory {
  contract              // Bewachungsvertrag
  privacyAgreement      // Datenschutzvereinbarung/AVV
  objectApproval        // Objektfreigabe
  training              // Unterweisung
  qualification         // Nachweise/Zertifikate
  insurance             // Versicherung
  correspondence        // Schriftverkehr
  other                 // Sonstiges
}

enum DataPurpose {
  contractFulfillment   // Vertragserfüllung
  billing               // Abrechnung & Buchhaltung
  customerService       // Kundenservice/Kommunikation
  legal                 // Gesetzliche Pflicht
  marketing             // Marketing (nur mit Einwilligung!)
}

// ═══════════════════════════════════════════════════
// SCHICHTBERICHTE (Digitales Formular)
// ═══════════════════════════════════════════════════

model ShiftReport {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  customerId      String    @db.VarChar(36)
  objectId        String    @db.VarChar(36)
  deploymentId    String?   @db.VarChar(36)
  
  // Berichtsinhalt
  reportDate      DateTime  @db.Date
  shiftStart      DateTime
  shiftEnd        DateTime
  personnelCount  Int       @default(1)
  
  // Schichtverlauf
  generalNotes    String?   @db.Text
  incidents       Json?     // Array: [{time, type, description, severity}]
  specialTasks    Json?     // Array: [{task, completed, notes}]
  handoverNotes   String?   @db.Text  // Übergabe an nächste Schicht
  
  // Kontrollgänge
  patrolChecks    Json?     // Array: [{location, time, status, notes}]
  
  // Anhänge
  attachmentUrls  Json?     // Array von URLs (Fotos, Dokumente)
  
  // Unterschrift/Bestätigung
  reportedById    String    @db.VarChar(36)  // Employee ID
  confirmedAt     DateTime?
  confirmedBy     String?   @db.VarChar(36)  // Vorgesetzter
  
  // PDF-Version
  pdfUrl          String?   @db.VarChar(500)
  
  status          ReportStatus @default(draft)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  object      SMSObject   @relation(fields: [objectId], references: [id])

  @@map("shift_reports")
}

enum ReportStatus {
  draft
  submitted
  approved
  archived
}

// ═══════════════════════════════════════════════════
// KUNDEN-PORTAL
// ═══════════════════════════════════════════════════

model CustomerUser {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  customerId      String    @db.VarChar(36)
  contactPersonId String?   @db.VarChar(36)
  email           String    @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  role            CustomerPortalRole @default(invoiceViewer)
  
  // Berechtigungen (sichtbare Bereiche)
  canViewInvoices    Boolean @default(true)
  canViewDeployments Boolean @default(false)
  canViewTimeRecords Boolean @default(false)
  canViewReports     Boolean @default(false)
  canApproveRecords  Boolean @default(false)
  
  // Login
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  passwordResetToken String? @db.VarChar(255)
  passwordResetTokenExpiry DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  contactPerson ContactPerson? @relation(fields: [contactPersonId], references: [id])

  @@unique([tenantId, email])
  @@map("customer_users")
}

enum CustomerPortalRole {
  invoiceViewer     // Nur Rechnungen einsehen
  reportViewer      // Rechnungen + Objektberichte
  fullAccess        // Alle Bereiche
  admin             // Vollzugriff + Benutzerverwaltung
}

// ═══════════════════════════════════════════════════
// KUNDEN-ZUGRIFFSPROTOKOLL (DSGVO)
// ═══════════════════════════════════════════════════

model CustomerAccessLog {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  customerId      String    @db.VarChar(36)
  userId          String?   @db.VarChar(36)  // Internal User ID
  customerUserId  String?   @db.VarChar(36)  // Customer Portal User ID
  action          String    @db.VarChar(100) // view, edit, export, login, etc.
  resourceType    String?   @db.VarChar(50)  // invoice, deployment, etc.
  resourceId      String?   @db.VarChar(36)
  ipAddress       String?   @db.VarChar(45)
  userAgent       String?   @db.Text
  createdAt       DateTime  @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt(sort: Desc)])
  @@map("customer_access_logs")
}

// ═══════════════════════════════════════════════════
// MAHNWESEN
// ═══════════════════════════════════════════════════

model Reminder {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  invoiceId       String    @db.VarChar(36)
  customerId      String    @db.VarChar(36)
  
  reminderLevel   ReminderStatus  // reminder1, reminder2, reminder3
  reminderDate    DateTime  @db.Date
  dueDate         DateTime  @db.Date
  amountDue       Decimal   @db.Decimal(10, 2)
  lateFees        Decimal   @db.Decimal(10, 2)
  
  // Text
  subject         String    @db.VarChar(200)
  message         String    @db.Text
  notes           String?   @db.Text
  
  // Versand
  sentAt          DateTime?
  sentVia         String?   @db.VarChar(50)  // email, post, portal
  paidAt          DateTime?
  
  // Ersteller
  createdById     String    @db.VarChar(36)
  createdAt       DateTime  @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  invoice    CustomerInvoice @relation(fields: [invoiceId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  createdBy  User            @relation("reminderCreatedBy", fields: [createdById], references: [id])

  @@map("reminders")
}

// ═══════════════════════════════════════════════════
// KONFIGURIERBARE PFLICHTFELDER (pro Tenant)
// ═══════════════════════════════════════════════════

model TenantFieldConfig {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  entityType      String   @db.VarChar(50)  // customer, employee, object, etc.
  fieldName       String   @db.VarChar(100)
  isRequired      Boolean  @default(false)
  label           String?  @db.VarChar(200)  // Anzeigename
  helpText        String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entityType, fieldName])
  @@map("tenant_field_configs")
}

// ═══════════════════════════════════════════════════
// SPERREN & SICHERHEIT
// ═══════════════════════════════════════════════════

model Lock {
  id          String    @id @default(uuid())
  resourceType String   @db.VarChar(50)
  resourceId  String    @db.VarChar(36)
  lockedById  String    @db.VarChar(36)
  sessionId   String    @db.VarChar(100)
  acquiredAt  DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  expiresAt   DateTime
  status      LockStatus @default(active)
  releasedAt  DateTime?

  lockedBy User @relation(fields: [lockedById], references: [id])

  @@index([resourceType, resourceId])
  @@map("locks")
}

enum LockStatus {
  active
  expired
  released
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @db.VarChar(36)
  token          String    @unique @db.VarChar(500)
  refreshToken   String    @unique @db.VarChar(500)
  ipAddress      String?   @db.VarChar(45)
  userAgent      String?   @db.Text
  deviceInfo     String?   @db.VarChar(200)
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// ═══════════════════════════════════════════════════
// PROTOKOLL & BENACHRICHTIGUNGEN
// ═══════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @db.VarChar(36)
  userId       String?  @db.VarChar(36)
  userName     String?  @db.VarChar(200)
  sessionId    String?  @db.VarChar(100)
  action       String   @db.VarChar(50)
  resourceType String   @db.VarChar(50)
  resourceId   String   @db.VarChar(36)
  entityType   String?  @db.VarChar(100)
  entityId     String?  @db.VarChar(36)
  changes      Json?
  metadata     Json?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String    @db.VarChar(36)
  type         String    @db.VarChar(50)
  title        String    @db.VarChar(200)
  message      String    @db.Text
  resourceType String?   @db.VarChar(50)
  resourceId   String?   @db.VarChar(36)
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════
// FEIERTAGE & ERSATZ
// ═══════════════════════════════════════════════════

model Holiday {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  date        DateTime @db.Date
  state       String?  @db.VarChar(10)
  isRecurring Boolean  @default(true)
  year        Int?
  createdAt   DateTime @default(now())

  @@unique([date, state])
  @@map("holidays")
}

model ReplacementRequest {
  id                      String   @id @default(uuid())
  deploymentId            String   @db.VarChar(36)
  originalEmployeeId      String   @db.VarChar(36)
  reason                  String   @db.Text
  status                  ReplacementStatus @default(pending)
  requestedById           String   @db.VarChar(36)
  resolvedById            String?  @db.VarChar(36)
  replacementEmployeeId   String?  @db.VarChar(36)
  replacementDeploymentId String?  @db.VarChar(36)
  candidates              Json?
  notes                   String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  deployment          Deployment  @relation(fields: [deploymentId], references: [id])
