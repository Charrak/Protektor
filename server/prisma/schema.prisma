}

// ═══════════════════════════════════════════════════
// HILFE-SYSTEM
// ═══════════════════════════════════════════════════

model HelpArticle {
  id          String    @id @default(uuid())
  category    String    @db.VarChar(50) // admin, user, api, troubleshooting
  subcategory String?   @db.VarChar(50)
  title       String    @db.VarChar(200)
  slug        String    @unique @db.VarChar(200)
  content     String    @db.Text
  tags        String[]
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([category])
  @@index([tags])
  @@map("help_articles")
}

model HelpSearch {
  id          String    @id @default(uuid())
  query       String    @db.VarChar(500)
  resultCount Int       @default(0)
  userId      String?   @db.VarChar(36)
  tenantId    String?   @db.VarChar(36)
  createdAt   DateTime  @default(now())
  
  @@index([query])
  @@map("help_searches")
}

// Schlüsselverwaltung für Sicherheitsfirmen
model SecurityKey {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  objectId        String    @db.VarChar(36)
  keyNumber       String    @db.VarChar(100)  // Schlüsselnummer
  keyType         String    @db.VarChar(100)  // Typ (z.B. "Zylinder", "Transponder")
  description     String?   @db.VarChar(500)
  totalCopies     Int       @default(1)  // Anzahl Kopien
  assignedTo      String?   @db.VarChar(36)  // Employee ID
  assignedDate    DateTime? @db.Date
  returnDate      DateTime? @db.Date
  status          KeyStatus @default(AVAILABLE)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  object    SMSObject @relation(fields: [objectId], references: [id])
  
  @@index([tenantId, status])
  @@index([assignedTo])
  @@map("security_keys")
}

enum KeyStatus {
  AVAILABLE
  ASSIGNED
  LOST
  RETURNED
  DEFECT
}

// Incident-Management (Besondere Vorkommnisse)
model SecurityIncident {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  objectId        String?   @db.VarChar(36)
  deploymentId    String?   @db.VarChar(36)
  reportedById    String    @db.VarChar(36)  // Employee ID
  incidentType    IncidentType
  severity        IncidentSeverity @default(MEDIUM)
  title           String    @db.VarChar(200)
  description     String    @db.Text
  location        String?   @db.VarChar(200)
  occurredAt      DateTime  @db.Timestamp
  reportedAt      DateTime  @default(now())
  resolvedAt      DateTime? @db.Timestamp
  resolvedById    String?   @db.VarChar(36)
  resolution      String?   @db.Text
  status          IncidentStatus @default(OPEN)
  policeReported  Boolean   @default(false)
  policeCaseNr    String?   @db.VarChar(100)
  insuranceReported Boolean @default(false)
  insuranceCaseNr String?   @db.VarChar(100)
  photos          Json?     // Array von Foto-URLs
  witnesses       Json?     // Array von Zeugen
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  object     SMSObject? @relation(fields: [objectId], references: [id])
  deployment Deployment? @relation(fields: [deploymentId], references: [id])
  reportedBy Employee   @relation("incidentReporter", fields: [reportedById], references: [id])
  resolvedBy Employee?  @relation("incidentResolver", fields: [resolvedById], references: [id])
  
  @@index([tenantId, status])
  @@index([incidentType, severity])
  @@index([occurredAt])
  @@map("security_incidents")
}

enum IncidentType {
  THEFT
  VANDALISM
  TRESPASSING
  ALARM_ACTIVATION
  MEDICAL_EMERGENCY
  FIRE
  ACCIDENT
  THREAT
  SUSPICIOUS_ACTIVITY
  TECHNICAL_FAILURE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Notfall-Protokolle / Alarmpläne
model EmergencyProtocol {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  objectId        String?   @db.VarChar(36)
  protocolType    String    @db.VarChar(100)  // z.B. "Brand", "Amok", "Evakuierung"
  title           String    @db.VarChar(200)
  description     String    @db.Text
  steps           Json      // Array von Schritten
  emergencyContacts Json    // Array von Kontakten
  evacuationRoutes  Json?   // Array von Fluchtwegen
  assemblyPoints    Json?   // Array von Sammelplätzen
  lastDrillDate     DateTime? @db.Date
  nextDrillDate     DateTime? @db.Date
  isActive          Boolean @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  object  SMSObject? @relation(fields: [objectId], references: [id])
  
  @@index([tenantId, isActive])
  @@map("emergency_protocols")
}

// Zutrittsberechtigungen
model AccessPermission {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  employeeId      String    @db.VarChar(36)
  objectId        String    @db.VarChar(36)
  permissionType  AccessPermissionType @default(FULL_ACCESS)
  validFrom       DateTime  @db.Date
  validUntil      DateTime? @db.Date
  timeRestrictions Json?    // z.B. {"weekdays": ["MO","TU","WE"], "timeFrom": "08:00", "timeUntil": "18:00"}
  isRevoked       Boolean   @default(false)
  revokedAt       DateTime? @db.Timestamp
  revokedBy       String?   @db.VarChar(36)
  revocationReason String?  @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  object   SMSObject @relation(fields: [objectId], references: [id])
  
  @@unique([employeeId, objectId])
  @@index([tenantId, isRevoked])
  @@map("access_permissions")
}

enum AccessPermissionType {
  FULL_ACCESS
  LIMITED_HOURS
  ESCORTED_ONLY
  SPECIFIC_AREAS
}

// ═══════════════════════════════════════════════════
// SUPPORT-TICKETS & KONTAKT
// ═══════════════════════════════════════════════════

model SupportTicket {
  id           String    @id @default(uuid())
  tenantId     String    @db.VarChar(36)
  userId       String    @db.VarChar(36)
  ticketNumber String    @unique @db.VarChar(20) // SUP-2026-0001
  
  category     String    @db.VarChar(50) // technical, billing, feature_request, bug, other
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus @default(OPEN)
  
  subject      String    @db.VarChar(200)
  description  String    @db.Text
  
  // Kontakt-Info
  contactEmail String?   @db.VarChar(100)
  contactPhone String?   @db.VarChar(30)
  
  // Zuweisung
  assignedTo   String?   @db.VarChar(36)
  
  // Anhänge
  attachments  Json?     // Array von File-IDs
  
  // Lösung
  resolution   String?   @db.Text
  resolvedAt   DateTime?
  
  // Bewertungen
  rating       Int?      // 1-5 Sterne
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?
  
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  messages     SupportTicketMessage[]
  
  @@index([tenantId, status])
  @@index([userId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String    @id @default(uuid())
  ticketId  String    @db.VarChar(36)
  userId    String?   @db.VarChar(36) // NULL bei System-Nachrichten
  isAdmin   Boolean   @default(false)
  
  message   String    @db.Text
  attachments Json?   // Array von File-IDs
  
  isRead    Boolean   @default(false)
  
  createdAt DateTime  @default(now())
  
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model ContactRequest {
  id           String    @id @default(uuid())
  tenantId     String?   @db.VarChar(36) // NULL bei öffentlichen Anfragen
  
  name         String    @db.VarChar(100)
  email        String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  company      String?   @db.VarChar(200)
  
  subject      String    @db.VarChar(200)
  message      String    @db.Text
  
  // Typ der Anfrage
  requestType  String    @db.VarChar(50) // demo, pricing, support, partnership, other
  
  // Status
  status       ContactRequestStatus @default(NEW)
  processedAt  DateTime?
  processedBy  String?   @db.VarChar(36)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  
  @@index([status, createdAt])
  @@map("contact_requests")
}

model Feedback {
  id           String    @id @default(uuid())
  tenantId     String?   @db.VarChar(36)
  userId       String?   @db.VarChar(36)
  
  // Feedback-Typ
  feedbackType FeedbackType
  
  // Inhalt
  subject      String    @db.VarChar(200)
  message      String    @db.Text
  
  // Kontext (welcher Bereich)
  context      String?   @db.VarChar(100) // z.B. "dashboard", "scheduling", "billing"
  url          String?   @db.VarChar(500)
  
  // Bewertung
  rating       Int?      // 1-5 Sterne
  
  // Technische Daten
  userAgent    String?   @db.VarChar(500)
  browser      String?   @db.VarChar(100)
  
  // Status
  status       FeedbackStatus @default(NEW)
  processedAt  DateTime?
  
  createdAt    DateTime  @default(now())
  
  @@index([feedbackType, createdAt])
  @@map("feedback")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_SUPPORT
  RESOLVED
  CLOSED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  IMPROVEMENT
  COMPLIMENT
  GENERAL
}

enum FeedbackStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ═══════════════════════════════════════════════
// USAGE TRACKING
// ═══════════════════════════════════════════════

model UsageEvent {
  id        String   @id @default(uuid())
  tenantId  String   @db.VarChar(36)
  resource  String   @db.VarChar(100)
  action    String   @db.VarChar(50)
  count     Int      @default(1)
  metadata  Json?
  trackedAt DateTime @default(now())

  @@index([tenantId, trackedAt])
  @@map("usage_events")
}

model UsageStat {
  id         String   @id @default(uuid())
  tenantId   String   @db.VarChar(36)
  resource   String   @db.VarChar(100)
  action     String   @db.VarChar(50)
  count      Int      @default(0)
  period     DateTime @db.Date
  periodType String   @db.VarChar(10) // DAILY, MONTHLY, YEARLY
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, resource, action, period])
  @@index([tenantId, period])
  @@map("usage_stats")
}

// ═══════════════════════════════════════════════
// ALLOWANCES (Zuschläge/Zulagen)
// ═══════════════════════════════════════════════

model Allowance {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(36)
  employeeId  String    @db.VarChar(36)
  date        DateTime  @db.Date
  type        String    @db.VarChar(50) // NIGHT, SUNDAY, HOLIDAY, OVERTIME
  amount      Decimal   @db.Decimal(10, 2)
  hours       Decimal   @db.Decimal(5, 2)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@index([tenantId, date])
  @@map("allowances")
}

// ═══════════════════════════════════════════════
// WEBHOOKS (Kunden-Webhooks)
// ═══════════════════════════════════════════════

model Webhook {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(36)
  url         String    @db.VarChar(500)
  secret      String    @db.VarChar(255)
  events      String[]  @db.VarChar(100) // Array von Event-Typen
  isActive    Boolean   @default(true)
  lastTrigger DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("webhooks")
}
