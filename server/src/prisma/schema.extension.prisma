// Erweiterung des bestehenden Prisma-Schemas für Multi-Tenancy

// ═══════════════════════════════════════════════════
// TENANT & LIZENZ (Neue Modelle)
// ═══════════════════════════════════════════════════

model Tenant {
  id             String    @id @default(uuid())
  companyName    String    @db.VarChar(200)
  contactEmail   String    @db.VarChar(255)
  licenseKey     String    @unique @db.VarChar(100)
  status         TenantStatus @default(TEST)
  maxEmployees   Int       @default(10)
  currentEmployees Int     @default(0)
  instanceId     String?   @unique @db.VarChar(100)
  lastHeartbeat  DateTime?
  offlineGraceDays Int     @default(7)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  
  // Relations
  users          User[]
  employees      Employee[]
  customers      Customer[]
  objects        SMSObject[]
  deployments    Deployment[]
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  
  @@map("tenants")
}

enum TenantStatus {
  TEST
  ACTIVE
  PAYMENT_PENDING
  GRACE_PERIOD
  RESTRICTED
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                    String    @id @default(uuid())
  tenantId              String    @db.VarChar(36)
  planId                String    @db.VarChar(36)
  stripeCustomerId      String?   @db.VarChar(100)
  stripeSubscriptionId  String?   @db.VarChar(100)
  status                SubscriptionStatus @default(ACTIVE)
  billingCycle          BillingCycle @default(MONTHLY)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  plan       Plan    @relation(fields: [planId], references: [id])
  
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Plan {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(100)
  description     String?   @db.Text
  stripePriceIdMonthly  String? @db.VarChar(100)
  stripePriceIdYearly   String? @db.VarChar(100)
  monthlyPrice    Decimal   @db.Decimal(10, 2)
  yearlyPrice     Decimal   @db.Decimal(10, 2)
  maxEmployees    Int
  features        Json      // JSON array of enabled features
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  subscriptions   Subscription[]
  
  @@map("plans")
}

model PaymentEvent {
  id              String    @id @default(uuid())
  tenantId        String    @db.VarChar(36)
  stripeEventId   String    @unique @db.VarChar(200)
  eventType       String    @db.VarChar(100)
  amount          Decimal?  @db.Decimal(10, 2)
  currency        String    @default("EUR") @db.VarChar(10)
  status          String    @db.VarChar(50)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  
  @@map("payment_events")
}

model LicenseCache {
  id              String    @id @default(uuid())
  tenantId        String    @unique @db.VarChar(36)
  lastValidCheck  DateTime
  status          TenantStatus
  maxEmployees    Int
  features        Json
  expiresAt       DateTime
  cachedAt        DateTime  @default(now())
  
  @@map("license_cache")
}

// ═══════════════════════════════════════════════════
